# Large and reproducible from Debian packages; kept in the backup tarball
c630/backups/*.tar.gz
c630/backups/**/vmlinuz*
c630/backups/**/initrd*
c630/backups/**/Persisted_Capsules.bin

# Personal assistant notes from the laptop; kept in the local tarball only
c630/backups/**/.claude/

# Lenovo/Qualcomm proprietary firmware: local only, never published
c630/firmware-local/
galaxy-book-go/firmware-local/
# Samsung ACPI tables: MSDM holds the Windows product key, so local only
galaxy-book-go/acpi-local/
