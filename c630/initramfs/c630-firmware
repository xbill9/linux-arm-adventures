#!/bin/sh
# initramfs-tools hook: put the C630 GPU and DSP firmware into the initramfs.
# msm (GPU) and qcom_q6v5_pas (adsp/cdsp/slpi) can probe before the root
# filesystem is mounted and do not retry a missing blob, and sid's
# initramfs-tools copies no qcom/ firmware on its own.
# Install as /etc/initramfs-tools/hooks/c630-firmware (mode 755).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
for f in qcom/a630_sqe.fw qcom/a630_gmu.bin qcom/sdm850/LENOVO/81JL/qcdxkmsuc850.mbn \
         qcom/sdm850/LENOVO/81JL/qcadsp850.mbn qcom/sdm850/LENOVO/81JL/qccdsp850.mbn \
         qcom/sdm850/LENOVO/81JL/qcslpi850.mbn; do
  add_firmware "$f" || echo "W: c630-firmware: $f not found" >&2
done
