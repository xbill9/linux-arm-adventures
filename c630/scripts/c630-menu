#!/bin/sh
# Write /boot/grub/c630.cfg: the C630's boot menu, read by GRUB 2.12 from /boot/efi.
# update-grub does not touch this file.
#
# Per installed kernel (newest first):
#   c630-<kver>         normal boot, all hardware/firmware
#   c630-safe-<kver>    SAFE: no Qualcomm DSP/modem/video/GPU firmware is loaded,
#                       and the pre-firmware initramfs is used if one was saved
#                       (/boot/c630boot/initrd-<kver>.pre-firmware)
#   c630-debug-<kver>   verbose, all hardware
#   c630-dtbtest-<kver> only if /boot/c630boot/dtb-<kver>.test exists: experimental DT
# plus c630-control: the installer stick's own kernel + installer.
#
# /etc/default/c630-menu:
#   C630_DEFAULT=<kver>     default kernel
#   C630_MODE=safe|full     default entry is the SAFE one or the normal one
#
# Boot an entry once (GRUB clears it as it boots, so a hang + power cycle
# comes back to the default):  c630-menu --once <entry-id> ["extra kernel args"]
#   e.g. c630-menu --once c630-7.2.9+deb14-arm64 "modprobe.blacklist=qcom_q6v5_mss"
# The extra args apply to that one boot only (variable c630_once_args in grubenv).
set -e

U=a81deabf-0654-4f68-b795-284305d26f13
# modprobe.blacklist=ipa: loading the IPA firmware resets the whole SoC (bisected 2026-10-10).
PB="clk_ignore_unused pd_ignore_unused regulator_ignore_unused usbcore.autosuspend=-1"
P="$PB modprobe.blacklist=ipa"
DBG="ignore_loglevel earlycon=efifb keep_bootcon"
SAFE="modprobe.blacklist=qcom_q6v5_pas,qcom_q6v5_mss,venus_core,ipa msm.skip_gpu=1"
DTB=qcom/sdm850-lenovo-yoga-c630.dtb
OUT=/boot/grub/c630.cfg
DIR=/boot/c630boot
C630_DEFAULT=6.12.107+deb13-arm64
C630_MODE=full
[ -r /etc/default/c630-menu ] && . /etc/default/c630-menu
case "$C630_MODE" in safe) DEF="c630-safe-$C630_DEFAULT" ;; *) DEF="c630-$C630_DEFAULT" ;; esac

if [ "$1" = "--once" ]; then
  grep -q -- "--id $2 " "$OUT" || { echo "no menu entry with id $2 in $OUT" >&2; exit 1; }
  grub-editenv /boot/grub/grubenv set next_entry="$2"
  if [ -n "$3" ]; then grub-editenv /boot/grub/grubenv set c630_once_args="$3"
  else grub-editenv /boot/grub/grubenv unset c630_once_args; fi
  grub-editenv /boot/grub/grubenv list
  exit 0
fi

mkdir -p $DIR
tmp=$(mktemp)
cat > "$tmp" <<EOF
# Generated by /usr/local/sbin/c630-menu. Do not edit; edit the script instead.
set timeout=10
search --no-floppy --fs-uuid --set=root $U
set default="$DEF"
if test -s \$prefix/grubenv; then
  load_env
  if test -n "\$next_entry"; then
    set default="\$next_entry"
    set next_entry=
    set once="\$c630_once_args"
    export once
    set c630_once_args=
    save_env next_entry c630_once_args
  fi
fi
EOF

for v in $(linux-version list | linux-version sort --reverse); do
  [ -f "/usr/lib/linux-image-$v/$DTB" ] && [ -f "/boot/initrd.img-$v" ] || continue
  cp "/usr/lib/linux-image-$v/$DTB" "$DIR/dtb-$v"
  safe_initrd=/boot/initrd.img-$v; safe_note=""
  [ -f "$DIR/initrd-$v.pre-firmware" ] && safe_initrd="$DIR/initrd-$v.pre-firmware" && safe_note=", pre-firmware initramfs"
  t1=""; t2=""
  [ "$DEF" = "c630-$v" ] && t1=" (default)"
  [ "$DEF" = "c630-safe-$v" ] && t2=" (default)"
  cat >> "$tmp" <<EOF

menuentry "[via \$c630_from] Debian $v$t1" --id c630-$v {
    devicetree /boot/c630boot/dtb-$v
    linux  /boot/vmlinuz-$v root=UUID=$U ro $P quiet \$once
    initrd /boot/initrd.img-$v
}
menuentry "[via \$c630_from] Debian $v SAFE - no Qualcomm firmware$safe_note$t2" --id c630-safe-$v {
    devicetree /boot/c630boot/dtb-$v
    linux  /boot/vmlinuz-$v root=UUID=$U ro $PB $SAFE quiet \$once
    initrd $safe_initrd
}
menuentry "[via \$c630_from] Debian $v - verbose debug" --id c630-debug-$v {
    devicetree /boot/c630boot/dtb-$v
    linux  /boot/vmlinuz-$v root=UUID=$U ro $P $DBG \$once
    initrd /boot/initrd.img-$v
}
EOF
  # Experimental DT: only listed while /boot/c630boot/dtb-<kver>.test exists; never the default.
  [ -f "$DIR/dtb-$v.test" ] && cat >> "$tmp" <<EOF
menuentry "[via \$c630_from] Debian $v - TEST device tree (dtb-$v.test)" --id c630-dtbtest-$v {
    devicetree /boot/c630boot/dtb-$v.test
    linux  /boot/vmlinuz-$v root=UUID=$U ro $P quiet \$once
    initrd /boot/initrd.img-$v
}
EOF
done

cat >> "$tmp" <<EOF

menuentry "[via \$c630_from] CONTROL - installer-stick kernel + installer (no USB needed)" --id c630-control {
    devicetree /boot/c630boot/c630.dtb
    linux  /boot/c630boot/vmlinuz rescue/enable=true --- $P
    initrd /boot/c630boot/initrd.gz
}
EOF

grub-script-check "$tmp"
grep -q -- "--id $DEF " "$tmp" || { echo "default entry $DEF missing; keeping old menu" >&2; rm -f "$tmp"; exit 1; }
[ -f "$OUT" ] && cp -a "$OUT" "$OUT.prev"
mv "$tmp" "$OUT"
chmod 644 "$OUT"
sync
echo "c630-menu: wrote $OUT (default $DEF)"
