#!/bin/sh
# Write /boot/grub/c630.cfg: the C630's boot menu, read by GRUB 2.12 from /boot/efi.
# One quiet and one verbose entry per installed kernel, each with its own DTB,
# plus the installer-stick control entry. update-grub does not touch this file.
#
# Default kernel: C630_DEFAULT in /etc/default/c630-menu.
# Boot another kernel once:  c630-menu --once <version>
#   GRUB clears it as it boots, so a hang + power cycle comes back to the default.
set -e

U=a81deabf-0654-4f68-b795-284305d26f13
P="clk_ignore_unused pd_ignore_unused regulator_ignore_unused usbcore.autosuspend=-1"
DBG="ignore_loglevel earlycon=efifb keep_bootcon"
DTB=qcom/sdm850-lenovo-yoga-c630.dtb
OUT=/boot/grub/c630.cfg
DIR=/boot/c630boot
C630_DEFAULT=6.12.107+deb13-arm64
[ -r /etc/default/c630-menu ] && . /etc/default/c630-menu

if [ "$1" = "--once" ]; then
  [ -f "/boot/vmlinuz-$2" ] || { echo "no such kernel: $2" >&2; exit 1; }
  grub-editenv /boot/grub/grubenv set next_entry="c630-$2"
  grub-editenv /boot/grub/grubenv list
  exit 0
fi

mkdir -p $DIR
tmp=$(mktemp)
cat > "$tmp" <<EOF
# Generated by /usr/local/sbin/c630-menu. Do not edit; edit the script instead.
set timeout=10
search --no-floppy --fs-uuid --set=root $U
set default="c630-$C630_DEFAULT"
if test -s \$prefix/grubenv; then
  load_env
  if test -n "\$next_entry"; then
    set default="\$next_entry"
    set next_entry=
    save_env next_entry
  fi
fi
EOF

for v in $(linux-version list | linux-version sort --reverse); do
  [ -f "/usr/lib/linux-image-$v/$DTB" ] && [ -f "/boot/initrd.img-$v" ] || continue
  cp "/usr/lib/linux-image-$v/$DTB" "$DIR/dtb-$v"
  tag=""; [ "$v" = "$C630_DEFAULT" ] && tag=" (default)"
  cat >> "$tmp" <<EOF

menuentry "[via \$c630_from] Debian $v$tag" --id c630-$v {
    devicetree /boot/c630boot/dtb-$v
    linux  /boot/vmlinuz-$v root=UUID=$U ro $P quiet
    initrd /boot/initrd.img-$v
}
menuentry "[via \$c630_from] Debian $v - verbose debug" --id c630-debug-$v {
    devicetree /boot/c630boot/dtb-$v
    linux  /boot/vmlinuz-$v root=UUID=$U ro $P $DBG
    initrd /boot/initrd.img-$v
}
EOF
done

cat >> "$tmp" <<EOF

menuentry "[via \$c630_from] CONTROL - installer-stick kernel + installer (no USB needed)" --id c630-control {
    devicetree /boot/c630boot/c630.dtb
    linux  /boot/c630boot/vmlinuz rescue/enable=true --- $P
    initrd /boot/c630boot/initrd.gz
}
EOF

grub-script-check "$tmp"
grep -q "id c630-$C630_DEFAULT " "$tmp" || { echo "default kernel $C630_DEFAULT has no entry; keeping old menu" >&2; rm -f "$tmp"; exit 1; }
[ -f "$OUT" ] && cp -a "$OUT" "$OUT.prev"
mv "$tmp" "$OUT"
chmod 644 "$OUT"
sync
echo "c630-menu: wrote $OUT (default c630-$C630_DEFAULT)"
