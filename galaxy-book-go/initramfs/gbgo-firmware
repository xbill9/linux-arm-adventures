#!/bin/sh
# initramfs-tools hook: put the Galaxy Book Go GPU firmware into the initramfs.
# msm can probe the GPU before the root filesystem is mounted (then it logs
# "Unable to load ...qcdxkmsuc7180.mbn" and retries later), and sid's
# initramfs-tools copies no qcom/ firmware on its own (seen on the C630).
# Install as /etc/initramfs-tools/hooks/gbgo-firmware (mode 755).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
for f in qcom/a630_sqe.fw qcom/a630_gmu.bin qcom/sc7180/samsung/galaxy-book-go/qcdxkmsuc7180.mbn; do
  add_firmware "$f" || echo "W: gbgo-firmware: $f not found" >&2
done
