#!/bin/sh
# Check the Galaxy Book Go audio bring-up after booting the audio test DTB
# (gbgo-dtb-audio.py). Prints the ADSP, codec and sound card state from this
# boot; with "play", routes MultiMedia1 to both MI2S ports (headset codec on
# primary, speaker amp on tertiary) and plays a 2 s tone on each channel.
#   gbgo-audio-check [play]     (as root)
set -e
echo "== kernel cmdline / DTB"
cat /proc/cmdline
echo "== remoteprocs"
for r in /sys/class/remoteproc/remoteproc*; do echo "$(cat "$r/name") $(cat "$r/state")"; done
echo "== kernel log (adsp, apr/q6, codec, amp, sound card)"
journalctl -k -b --no-pager -o short-monotonic \
  | grep -i -E '62400000|remoteproc|adsp|apr|q6(afe|asm|adm|core|routing)|rt5682|a8c000|max98357|sndcard|asoc|snd_soc|sc7180-qdsp6' \
  | tail -60 || true
echo "== cards"
cat /proc/asound/cards
aplay -l 2>&1 || true
CARD=$(awk '/Samsung-Galaxy-Book-Go|SamsungGalaxyBo/{print $1; exit}' /proc/asound/cards)
[ -n "$CARD" ] || { echo "no Galaxy Book Go sound card"; exit 1; }
echo "== MI2S routing controls on card $CARD"
amixer -c "$CARD" controls | grep -E 'MI2S_RX Audio Mixer MultiMedia1' || true
[ "$1" = play ] || exit 0
amixer -c "$CARD" controls | grep -E 'MI2S_RX Audio Mixer MultiMedia1' \
  | sed "s/.*name='\([^']*\)'.*/\1/" | while read -r c; do
    amixer -c "$CARD" cset name="$c" on >/dev/null && echo "on: $c"
  done
echo "== tone on hw:$CARD,0 (speakers and headphone jack)"
timeout 15 speaker-test -D "hw:$CARD,0" -c 2 -r 48000 -F S16_LE -t sine -f 440 -l 1 -P 4 2>&1 | tail -8
