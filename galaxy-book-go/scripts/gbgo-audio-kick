#!/bin/sh
# Bring up the Galaxy Book Go's sound card at boot. On some boots the audio DSP
# (remoteproc "adsp") comes up early (3.2 s instead of ~9 s) and its APR audio
# services never register: no `Adding APR/GPR dev` lines, and the card stays in
# deferred probe ("MultiMedia1: error getting cpu dai name"). Restarting the
# DSP registers the services and the card probes (tested 2026-10-18).
# Run by gbgo-audio-kick.service; does nothing if card 0 already exists.
# After a restart it reapplies the saved mixer routes with `alsactl restore`.
set -e
card_up() { [ -e /proc/asound/card0 ]; }
NAME=adsp
for _ in $(seq 1 20); do
  card_up && { echo "sound card present"; exit 0; }
  sleep 1
done
R=
for r in /sys/class/remoteproc/remoteproc*; do
  [ "$(cat "$r/name")" = "$NAME" ] && R=$r
done
[ -n "$R" ] || { echo "no remoteproc $NAME" >&2; exit 1; }
echo "no sound card after 20 s; restarting $NAME ($R)"
[ "$(cat "$R/state")" = running ] && echo stop > "$R/state"
sleep 2
echo start > "$R/state"
for _ in $(seq 1 30); do
  if card_up; then
    sleep 1
    alsactl restore 0 || true
    echo "sound card up after restart"
    exit 0
  fi
  sleep 1
done
echo "sound card still missing after restart" >&2
exit 1
