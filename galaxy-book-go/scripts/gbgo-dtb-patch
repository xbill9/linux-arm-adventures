#!/bin/sh
# Build the patched Galaxy Book Go DTB from the installer stick's draft DTB.
#   gbgo-dtb-patch <stick.dtb> <out.dtb>
# Each fix was checked against Samsung's own ACPI tables (dumped 2026-10-11,
# see ACPI.md). Prints the dts diff, so every change is visible.
#  1. keyboard IRQ: the draft uses TLMM 48 ("this one is wrong" in its source),
#     which idles low, so i2c-hid polls the keyboard ~1100x/s and floods the
#     log. ACPI ECKB: GpioInt(Level, ActiveLow, PullUp) on GIO0 virtual pin
#     0x140 = direct-connect IRQ #5 = PDC pin 67 = TLMM 104.
#  2. power button: the draft disables pon@800, so pm8941-pwrkey never binds.
#  (RTC: left disabled. Enabling rtc@6000 was tested 2026-10-11: the PMIC
#   counter reads 1970-01-03 (Samsung's firmware keeps the offset elsewhere), so
#   the kernel set the system clock to 1970 at every boot until NTP. Off is
#   better than wrong; the clock comes from systemd-timesyncd.)
#  4. backlight: Samsung's panel config (GPU0._ROM XML: BacklightType 1,
#     PmicControlType 3, PmicNum 2, 6250 Hz) = PWM from the PM6150L LPG. The
#     draft DTB disables the LPG, so there is no brightness control. Enable the
#     LPG and add pwm-backlight on channel index 3 (LPG4), not linked to the
#     panel node (a failed backlight probe must not hold back the panel).
#     2026-10-12: LPG3 (index 2) follows a pwm-backlight but leaves the screen
#     unchanged; LPG4, left running by the firmware at 50 %, dims and brightens
#     the screen when driven through /sys/class/pwm (seen by the user).
#     Only applied with GBGO_BACKLIGHT=1. The bridge PWM (pwmchip0,
#     ti_sn65dsi86.pwm) was tested live 2026-10-11 and does not change brightness.
#  3. lid: no node at all. ACPI LID0 returns the raw level of GPIO 93
#     (1 = open), so SW_LID on TLMM 93, active low.
#  5. display bridge IRQ: the draft keeps the Aspire 1's ti,sn65dsi86 interrupt
#     on TLMM 11, level-high. Here GPIO 11 reads high with its pull-down, so the
#     IRQ never clears ("irq N: nobody cared", disabled after 100,001 at every
#     boot). Samsung's ACPI declares no GPIO interrupt for the bridge (the eDP
#     panel needs none), so the bridge loses interrupts-parent/interrupts and
#     the irq pin config from pinctrl-0; the driver then runs without an IRQ.
#  6. battery: the EC's smart battery gauge answers at 0x0b on i2c@890000
#     (ACPI EMEC, I2C to 0x09 and 0x0b there). Read live 2026-10-12 with
#     sbs-battery bound by hand: SDI 4432D53, 7720 mV design, 5320 mAh design.
#     Added as an sbs,sbs-battery node. The charger at 0x09 answers 0xffff to
#     the SBS charger registers and is left out.
#  7. camera: a Chicony 720p UVC camera (04f2:b72f) on port 4 of the internal
#     USB hub (ACPI EHUB.PRT1.ICAM, _ADR 4). EHUB._PS0 sets GIO0.CAME, a GpioIo
#     output on TLMM 13; the boot firmware leaves it low, so the camera never
#     enumerates. Driven high by hand 2026-10-12: it enumerated and uvcvideo
#     captured 1280x720. A gpio-hog holds TLMM 13 high from boot.
set -e
IN=$1; OUT=$2
[ -f "$IN" ] && [ -n "$OUT" ] || { sed -n '2,3p' "$0"; exit 1; }
T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
dtc -q -I dtb -O dts -o "$T/in.dts" "$IN"
# the bridge IRQ pin config's phandle (fix 5)
BIRQ=$(awk '/edp-bridge-irq-default-state \{/{f=1} f&&/phandle = </{gsub(/.*<|>.*/,""); print; exit}' "$T/in.dts")
[ -n "$BIRQ" ] || { echo "bridge irq pin config not found" >&2; exit 1; }
TLMM=$(awk '/pinctrl@3500000 \{/{f=1} f&&/phandle = </{gsub(/.*<|>.*/,""); print; exit}' "$T/in.dts")
[ -n "$TLMM" ] || { echo "TLMM phandle not found" >&2; exit 1; }
# a phandle no node uses yet, for the LPG
LPGPH=$(printf '0x%x' $(( $(grep -o 'phandle = <0x[0-9a-f]*>' "$T/in.dts" | sed 's/.*<\(0x[0-9a-f]*\)>/\1/' | sort -u | while read -r h; do printf '%d\n' "$h"; done | sort -n | tail -1) + 1 )))
BL=${GBGO_BACKLIGHT:-0}
awk -v t="$TLMM" -v lpgph="$LPGPH" -v bl="$BL" -v birq="$BIRQ" '
  # 3. lid switch: a new top-level node, just before the root node closes
  #    (dtc wants a node'"'"'s properties before its subnodes)
  /^\};$/ && !lid { lid=1
    print ""
    print "\tgpio-keys {"
    print "\t\tcompatible = \"gpio-keys\";"
    print "\t\tswitch-lid {"
    print "\t\t\tlabel = \"Lid\";"
    print "\t\t\tgpios = <" t " 0x5d 0x01>;"
    print "\t\t\tlinux,input-type = <0x05>;"
    print "\t\t\tlinux,code = <0x00>;"
    print "\t\t};"
    print "\t};"
    if (bl == 1) {
      print ""
      print "\tbacklight {"
      print "\t\tcompatible = \"pwm-backlight\";"
      print "\t\tpwms = <" lpgph " 0x03 0x27100>;"
      print "\t};"
    }
    print; next }
  # 4. backlight: enable the PM6150L LPG and give it a phandle
  /^\t*pwm \{$/ {pwmn=1; pwmd=""}
  pwmn && /compatible = "qcom,pm6150l-lpg"/ {pwmd=1}
  bl == 1 && pwmn && pwmd && /status = "disabled";/ { sub("\"disabled\"", "\"okay\""); print; print "\t\t\t\t\tphandle = <" lpgph ">;"; pwmn=0; next }
  pwmn && /^\t*\};/ {pwmn=0}
  # 1. keyboard IRQ + its pin config
  /keyboard@5 \{/ {k=1}
  k && /interrupts-extended = </ { sub("<" t " 0x30 0x08>", "<" t " 0x68 0x08>") }
  k && /^\t*\};/ {k=0}
  /hid-keyboard-default-state \{/ {p=1}
  p && /pins = "gpio48";/ { sub("gpio48", "gpio104") }
  p && /bias-disable;/ { sub("bias-disable", "bias-pull-up") }
  p && /^\t*\};/ {p=0}
  # 7. camera power: gpio-hog on TLMM 13, before the first TLMM subnode
  /pinctrl@3500000 \{/ {tl=1; next_sub=1; print; next}
  tl && next_sub && /^\t+[a-z0-9_-]+(@[0-9a-f]+)? \{$/ { ind=$0; sub(/[^\t].*$/, "", ind)
    print ind "camera-power-hog {"; print ind "\tgpio-hog;"; print ind "\tgpios = <0x0d 0x00>;"; print ind "\toutput-high;"; print ind "\tline-name = \"camera-power\";"; print ind "};"; print ""
    next_sub=0; tl=0 }
  # 6. battery on i2c@890000, before the bus node closes
  /i2c@890000 \{/ {bat=1}
  bat && /^\t*\};$/ { ind=$0; sub(/\};$/, "", ind)
    print ind "\tbattery@b {"; print ind "\t\tcompatible = \"sbs,sbs-battery\";"; print ind "\t\treg = <0x0b>;"; print ind "\t};"
    bat=0 }
  # 5. display bridge: no IRQ
  /bridge@2c \{/ {br=1}
  br && /^\t*interrupt-parent = </ { next }
  br && /^\t*interrupts = </ { next }
  br && /pinctrl-0 = </ { sub(" " birq " ", " "); sub("<" birq " ", "<"); sub(" " birq ">", ">") }
  br && /^\t*(aux-bus|ports) \{/ {br=0}
  br && /^\t*\};/ {br=0}
  # 2. power button: drop pon@800 status = "disabled" (resin keeps its own)
  /pon@800 \{/ {pon=1}
  pon && /^\t*(pwrkey|resin) \{/ {pon=0}
  pon && /status = "disabled";/ { next }
  {print}' "$T/in.dts" > "$T/out.dts"
diff -u "$T/in.dts" "$T/out.dts" || true
# exactly the expected edits: +25 (3 keyboard, 10 lid, 1 bridge pinctrl, 4 battery,
# 7 camera hog)
# -7 (3 keyboard, pon status, 3 bridge),
# plus +7 -1 with GBGO_BACKLIGHT=1 (2 lpg, 5 backlight; lpg status)
add=$(diff "$T/in.dts" "$T/out.dts" | grep -c '^>' || true)
del=$(diff "$T/in.dts" "$T/out.dts" | grep -c '^<' || true)
want_add=25; want_del=7; [ "$BL" = 1 ] && want_add=32 && want_del=8
[ "$add" = "$want_add" ] && [ "$del" = "$want_del" ] || { echo "unexpected diff: +$add -$del (want +$want_add -$want_del)" >&2; exit 1; }
dtc -q -I dts -O dtb -o "$OUT" "$T/out.dts"
echo "wrote $OUT"
